Options -MultiViews
RewriteEngine On

# Force HTTPS + non-www
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\.mr-soomro\.com$ [NC]
RewriteRule ^ https://mr-soomro.com%{REQUEST_URI} [R=301,L]

# Redirect /index or /index.html to /
RewriteCond %{THE_REQUEST} \s/+index(?:\.html?)?[\s?] [NC]
RewriteRule ^index(?:\.html?)?$ / [R=301,L]

# Redirect any .html request (at any depth) to its clean root-level URL
RewriteCond %{THE_REQUEST} \s/+(?:[^/]+/)*([^/.]+)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# Redirect /pages/XYZ or /pages/blog/XYZ to /XYZ (clean root URL)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^pages/(?:blog/)?([^/]+)/?$ /$1 [R=301,L]

# Remove trailing slash from non-directories (to prevent broken relative assets)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} (.+)/$
RewriteRule ^ %1 [R=301,L]

# Serve clean URLs from matching .html files in root directory
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^([^/]+)/?$ $1.html [L]

# Serve clean URLs from matching .html files in pages/ directory
RewriteCond %{DOCUMENT_ROOT}/pages/$1.html -f
RewriteRule ^([^/]+)/?$ pages/$1.html [L]

# Serve clean URLs from matching .html files in pages/blog/ directory
RewriteCond %{DOCUMENT_ROOT}/pages/blog/$1.html -f
RewriteRule ^([^/]+)/?$ pages/blog/$1.html [L]

DirectoryIndex index.html
