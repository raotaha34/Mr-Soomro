# Copy to .env and fill in real values. Never commit .env.

PORT=5000

# Groq API key (Free tier with generous limits): https://console.groq.com/keys
GROQ_API_KEY=

# Optional. Defaults to llama-3.1-8b-instant (fast, free model).
# Available models: llama-3.1-8b-instant, llama-3.3-70b-versatile, gemma2-9b-it, mixtral-8x7b-32768
GROQ_MODEL=llama-3.1-8b-instant
GROQ_TIMEOUT_MS=30000
GROQ_MAX_OUTPUT_TOKENS=512

# Any long random string. Required to read captured leads via GET /api/lead.
ADMIN_API_KEY=

# Extra browser origins allowed to call the API, comma separated.
# Only needed when the website is hosted somewhere other than this server.
ALLOWED_ORIGINS=

# Number of reverse proxies in front of the app (0 when running it directly).
# Rate limiting keys on the client IP, so this must be accurate behind Nginx/Cloudflare.
TRUST_PROXY_HOPS=0
