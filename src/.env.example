# Copy to .env and fill in real values. Never commit .env.

PORT=5000

# Google AI Studio key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Defaults to gemini-flash-latest.
# List models your key can use:
#   curl "https://generativelanguage.googleapis.com/v1beta/models" -H "x-goog-api-key: $GEMINI_API_KEY"
GEMINI_MODEL=gemini-flash-latest
GEMINI_TIMEOUT_MS=30000
GEMINI_MAX_OUTPUT_TOKENS=512

# Any long random string. Required to read captured leads via GET /api/lead.
ADMIN_API_KEY=

# Extra browser origins allowed to call the API, comma separated.
# Only needed when the website is hosted somewhere other than this server.
ALLOWED_ORIGINS=

# Number of reverse proxies in front of the app (0 when running it directly).
# Rate limiting keys on the client IP, so this must be accurate behind Nginx/Cloudflare.
TRUST_PROXY_HOPS=0
